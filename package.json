{
  "name": "useflowmap",
  "version": "0.1.1",
  "description": "See every screen of your web app as the code renders it, compare it with live, and send changes back to your coding agents.",
  "keywords": [
    "mcp",
    "coding-agents",
    "screenshots",
    "visual-regression",
    "ui-review",
    "playwright",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dammyjay93/flowmap.git"
  },
  "homepage": "https://github.com/Dammyjay93/flowmap#readme",
  "bugs": {
    "url": "https://github.com/Dammyjay93/flowmap/issues"
  },
  "type": "module",
  "bin": {
    "flowmap": "dist/cli.js",
    "useflowmap": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "viewer/index.html",
    "viewer/icons.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/icons.mjs",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "diff": "^9.0.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/solar": "^1.2.14",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
